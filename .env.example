# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value here has a working default in
# config/settings.py, so the API runs with no .env file at all.
# ---------------------------------------------------------------------------

# Django core
# DJANGO_SECRET_KEY: set a real random value before you deploy anywhere public.
DJANGO_SECRET_KEY=insecure-dev-key-change-me
# DJANGO_DEBUG: keep this False outside your own machine.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. SQLite needs no setup and holds the ~8k station rows comfortably.
# Swap in PostgreSQL with: postgres://user:pass@localhost:5432/fuelroute
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Routing provider (OSRM). The public demo server needs no API key.
# The planner makes exactly ONE call to this service per request.
# Run your own with Docker if the demo server rate-limits you:
#   docker run -p 5000:5000 osrm/osrm-backend osrm-routed /data/us-latest.osrm
# ---------------------------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=25.0

# ---------------------------------------------------------------------------
# Geocoder (Nominatim). Only called when a place name is not already cached in
# the database. Send lat/lon in the request to skip the geocoder entirely.
# NOMINATIM_USER_AGENT: the OSM usage policy requires a real contact string.
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-api/1.0 (backend assessment)
NOMINATIM_TIMEOUT_SECONDS=10.0

# ---------------------------------------------------------------------------
# Vehicle and matching parameters. The assessment fixes the first two.
# ---------------------------------------------------------------------------
# VEHICLE_MAX_RANGE_MILES: full-tank range. 500 mi / 10 mpg implies a 50 gal tank.
VEHICLE_MAX_RANGE_MILES=500.0
VEHICLE_MILES_PER_GALLON=10.0
# MAX_DETOUR_MILES: how far off the polyline a station may sit and still count.
MAX_DETOUR_MILES=15.0
# MIN_STOP_SPACING_MILES: least distance between two chosen stops. It stops the
# planner from pulling off the road twice in one mile to buy a splash of fuel.
# Set 0 for the mathematically unconstrained optimum.
MIN_STOP_SPACING_MILES=10.0
# ORIGIN_FALLBACK_RADIUS_MILES: widened search used only to find the first stop
# when no station sits within MAX_DETOUR_MILES of the origin.
ORIGIN_FALLBACK_RADIUS_MILES=75.0
# ROUTE_SAMPLE_STRIDE_METERS: polyline resampling step before the spatial index
# is built. Smaller is more exact and slower.
ROUTE_SAMPLE_STRIDE_METERS=250.0
